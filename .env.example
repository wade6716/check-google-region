# ==========================================
# check-google-region 配置项
# ==========================================

# 状态缓存文件路径（可选，Linux 默认 /var/tmp/last_google_country.json，Windows 默认临时目录）
# STATE_FILE=/var/tmp/last_google_country.json

# SMTP 邮件配置 (465端口走SSL，587端口自动走STARTTLS)
# QQ 邮箱示例: smtp.qq.com:465
# 163 邮箱示例: smtp.163.com:465
# Gmail 示例: smtp.gmail.com:587
# Outlook 示例: smtp.office365.com:587
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_auth_token
RECEIVER_EMAIL=target@example.com

# 代理配置 (可选，例如检测指定代理出口)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# SSL 证书验证 (默认 false 进行安全验证；若有抓包或自签证书需求可设为 true)
# INSECURE_SSL=false

# Telegram Bot 通知 (可选)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=123456789

# 自定义 Webhook 通知 (可选，如飞书/企业微信/Bark/自建接口)
# WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx

# 常驻守护模式与检测间隔配置 (可选)
# DAEMON_MODE=false
# CHECK_INTERVAL=3600    # 检测间隔秒数，默认 3600 秒 (1 小时)
